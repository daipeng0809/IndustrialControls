<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IndustrialControls.Demo.ViewModels"
        xmlns:views="using:IndustrialControls.Demo.Views"
        xmlns:ic="https://github.com/daipeng0809/IndustrialControls"
        x:Class="IndustrialControls.Demo.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="IndustrialControls · Avalonia 12 工业控件库"
        Icon="/Assets/icon.png"
        Width="1360"
        Height="900"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

  <Grid RowDefinitions="Auto,*" RowSpacing="14" Margin="24,18,24,20">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="6" Height="28" CornerRadius="3" Background="{StaticResource AccentBrush}" />
          <TextBlock Classes="h1" Text="IndustrialControls" />
          <Border Classes="chip"><TextBlock Text="Avalonia 12" /></Border>
          <Border Classes="chip"><TextBlock Text="AOT Ready" /></Border>
          <Border Classes="chip"><TextBlock Text="High Performance" /></Border>
        </StackPanel>
        <TextBlock Classes="caption"
                   Text="工业仪表盘 / 扇形进度条 / 竖向进度条 / 电池电量 / 指南针 / 状态灯" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <ic:StatusLight Status="{Binding DeviceStatus}" Label="数据链路正常" IsPulsing="True" />
        <Border Classes="chip">
          <TextBlock Text="{Binding LastUpdateText}" />
        </Border>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1">
      <TabItem Header="运行仪表板">
        <views:OverviewView />
      </TabItem>
      <TabItem Header="控件画廊">
        <views:GalleryView />
      </TabItem>
      <TabItem Header="性能压力测试">
        <views:StressTestView />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
